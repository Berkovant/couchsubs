<UserControl x:Class="CouchSubs.App.Views.Steps.XboxConsoleStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls">
    <c:StepLayout Title="Ev Xbox konsolunu seç"
                  Message="Xbox açık ve bilgisayarla aynı ağda olmalı. Xbox ayarlarında uzaktan oynatmayı etkinleştir.">
        <StackPanel>
            <Button x:Name="Refresh" Content="Konsolları ara" Style="{StaticResource PrimaryButton}" Click="OnRefresh" />
            <TextBlock x:Name="Status" Style="{StaticResource HintText}" Margin="0,16,0,8" TextWrapping="Wrap" />
            <StackPanel x:Name="Consoles" />
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </c:StepLayout>
</UserControl>
