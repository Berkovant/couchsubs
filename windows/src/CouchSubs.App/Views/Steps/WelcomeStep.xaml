<UserControl x:Class="CouchSubs.App.Views.Steps.WelcomeStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout Title="{t:T 'Welcome to CouchSubs'}"
                  Message="CouchSubs oyun görüntüsündeki altyazıları okur ve çeviriyi TV'de ya da bilgisayarda gösterir. Oynamaya kendi kumandanızla devam edersiniz.">
        <StackPanel>
            <c:Card Title="Konsolunu seç">
                <StackPanel>
                    <RadioButton x:Name="Ps5" Content="PlayStation 5" GroupName="consoleKind" Margin="0,0,0,12" Checked="OnSelected" />
                    <RadioButton x:Name="Xbox" Content="Xbox Series / Xbox One" GroupName="consoleKind" Checked="OnSelected" />
                </StackPanel>
            </c:Card>
            <TextBlock x:Name="Requirements" Margin="0,20,0,0" TextWrapping="Wrap" Style="{StaticResource HintText}" />
        </StackPanel>
    </c:StepLayout>
</UserControl>
